# Environment variables for the app. Copy the relevant lines into
# `.env.development.local` (debug builds and Metro) and
# `.env.production.local` (release builds). Both are gitignored; this file is
# not, so never put a real secret here.
#
# Expo picks the file by NODE_ENV, and `.env.local` outranks `.env.<mode>`,
# so use the mode-specific `.local` files rather than a shared `.env.local` —
# otherwise a dev override silently leaks into release builds.

# Signalling rendezvous (infra/rendezvous).
#   production:  https://hhfh.v-collaborate.com
#   development: http://localhost:8787  (with `adb reverse tcp:8787 tcp:8787`)
EXPO_PUBLIC_RENDEZVOUS_URL=

# Long-term credential for the coturn TURN server (user "hhfh"), matching the
# user= line in infra/coturn/turnserver.conf. Without it the off-LAN path falls
# back to STUN only and will fail behind symmetric NAT.
EXPO_PUBLIC_TURN_CREDENTIAL=
