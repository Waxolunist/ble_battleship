# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put the real value here.
#
# Long-term credential for the coturn TURN server (user "hhfh"), matching the
# user= line in infra/coturn/turnserver.conf. Without it the off-LAN relay path
# falls back to STUN only and will fail behind symmetric NAT.
EXPO_PUBLIC_TURN_CREDENTIAL=
